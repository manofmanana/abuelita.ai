# Copy to .env (or set in your host's dashboard). All values are optional for local dev.

# Local development: turn on debug mode (never in production).
DJANGO_DEBUG=1

# Production: required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated hostnames / origins for production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional: Postgres instead of SQLite.
# DATABASE_URL=postgres://user:password@host:5432/abuelita

# Optional hardening behind HTTPS.
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000

# Optional limits.
# ABUELITA_MAX_UPLOAD_MB=5
# ABUELITA_MAX_TRANSLATE_CHARS=20000

# Skip all network calls (translations become "[es] text"); used by the tests.
# ABUELITA_OFFLINE=1
