#: translator/templates/translator/culture.html:5
msgid "Cultural Wisdom - Abuelita.ai"
msgstr "Sabiduría cultural - Abuelita.ai"

#: translator/templates/translator/culture.html:11
msgid "Cultural Wisdom"
msgstr "Sabiduría cultural"

#: translator/templates/translator/culture.html:14
msgid ""
"Learn idioms, slang, and traditions — explained with Abuelita’s warmth and "
"humor."
msgstr ""
"Aprende modismos, expresiones y tradiciones — explicadas con la calidez y el "
"humor de Abuelita."

#: translator/templates/translator/culture.html:21
msgid "Enter a phrase, idiom, or tradition:"
msgstr "Ingresa una frase, modismo o tradición:"

#: translator/templates/translator/culture.html:29
msgid "e.g. Pan de Muerto, Si Dios quiere, Quinceañera..."
msgstr "Ej: Pan de Muerto, Si Dios quiere, Quinceañera..."

#: translator/templates/translator/culture.html:34
msgid "Get Cultural Insight"
msgstr "Obtener explicación cultural"

#: translator/templates/translator/culture.html:41
msgid "Abuelita’s Explanation"
msgstr "Explicación de Abuelita"

#: translator/templates/translator/culture.html:54
msgid "Explore Popular Topics"
msgstr "Explora temas populares"

#: translator/templates/translator/culture.html:61
msgid "Fiestas and Music"
msgstr "Fiestas y música"

#: translator/templates/translator/culture.html:62
msgid "Discover Latin rhythms and traditions behind every celebration."
msgstr "Descubre los ritmos y tradiciones latinas detrás de cada celebración."

#: translator/templates/translator/culture.html:70
msgid "Idioms & Humor"
msgstr "Modismos y humor"

#: translator/templates/translator/culture.html:71
msgid "Understand everyday sayings and the playful spirit behind them."
msgstr "Comprende los dichos cotidianos y el espíritu alegre que encierran."

#: translator/templates/translator/culture.html:79
msgid "Family & Traditions"
msgstr "Familia y tradiciones"

#: translator/templates/translator/culture.html:80
msgid "Learn the values, food, and customs that shape generations."
msgstr "Aprende los valores, comidas y costumbres que forman generaciones."

