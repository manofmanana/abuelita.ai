# =========================
# about.html
# =========================
#: translator/templates/translator/about.html:4
msgid "About - Abuelita.ai"
msgstr "Acerca de - Abuelita.ai"

#: translator/templates/translator/about.html:17
msgid "For My Abuelita,"
msgstr "Para mi Abuelita,"

#: translator/templates/translator/about.html:18
msgid "Francisca Martínez"
msgstr "Francisca Martínez"

#: translator/templates/translator/about.html:21
msgid "Abuelita.ai was created in honor of my grandmother, who inspired this project with her strength, curiosity, and love for learning, so no abuela ever has to wait to understand the world again."
msgstr "Abuelita.ai fue creado en honor a mi abuela, quien inspiró este proyecto con su fuerza, curiosidad y amor por el aprendizaje — para que ninguna abuela tenga que esperar para entender el mundo otra vez."

#: translator/templates/translator/about.html:35
msgid "Abuelita portrait"
msgstr "Retrato de Abuelita"

#: translator/templates/translator/about.html:41
msgid "Her Story"
msgstr "Su historia"

#: translator/templates/translator/about.html:44
msgid "Born in Nochistlán, Zacatecas, México, Francisca dedicated her life to her family and community. Moving to the U.S., she faced the challenge of learning a new language while preserving her Mexican roots."
msgstr "Nacida en Nochistlán, Zacatecas, México, Francisca dedicó su vida a su familia y comunidad. Al mudarse a los Estados Unidos, enfrentó el desafío de aprender un nuevo idioma mientras preservaba sus raíces mexicanas."

#: translator/templates/translator/about.html:49
msgid "She inspired the mission behind Abuelita.ai, blending technology with empathy, helping people communicate across generations and cultures."
msgstr "Ella inspiró la misión detrás de Abuelita.ai — combinando la tecnología con empatía, ayudando a las personas a comunicarse entre generaciones y culturas."

#: translator/templates/translator/about.html:62
msgid "Our Mission"
msgstr "Nuestra misión"

#: translator/templates/translator/about.html:75
msgid "Empower Communication"
msgstr "Fortalecer la comunicación"

#: translator/templates/translator/about.html:77
msgid "Breaking language barriers through translation and cultural connection."
msgstr ""
"Rompiendo las barreras del idioma mediante la traducción y la conexión "
"cultural."

#: translator/templates/translator/about.html:87
msgid "Honor Heritage"
msgstr "Honrar la herencia"

#: translator/templates/translator/about.html:89
msgid ""
"Preserving the wisdom, warmth, and voice of our elders in every interaction."
msgstr ""
"Preservando la sabiduría, la calidez y la voz de nuestros mayores en cada "
"interacción."

#: translator/templates/translator/about.html:99
msgid "Inspire Learning"
msgstr "Inspirar el aprendizaje"

#: translator/templates/translator/about.html:101
msgid ""
"Encouraging curiosity and growth through bilingual education and AI tools."
msgstr ""
"Fomentando la curiosidad y el crecimiento mediante la educación bilingüe y "
"las herramientas de IA."

#: translator/templates/translator/about.html:115
msgid "Para que nunca más una abuela tenga que esperar a entender el mundo."
msgstr "Para que nunca más una abuela tenga que esperar a entender el mundo."

#: translator/templates/translator/about.html:119
msgid "Dedicated to all the grandmothers who inspire us to keep learning."
msgstr "Dedicado a todas las abuelas que nos inspiran a seguir aprendiendo."

