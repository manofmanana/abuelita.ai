#: translator/templates/translator/learn.html:5
#: translator/templates/translator/learn.html:12
msgid "Language Learning Hub"
msgstr "Centro de aprendizaje de idiomas"

#: translator/templates/translator/learn.html:15
msgid ""
"Guided lessons by Abuelita — learn languages with warmth, humor, and "
"cultural wisdom."
msgstr ""
"Lecciones guiadas por Abuelita — aprende idiomas con calidez, humor y "
"sabiduría cultural."

#: translator/templates/translator/learn.html:25
msgid "Start a Lesson"
msgstr "Comenzar una lección"

#: translator/templates/translator/learn.html:26
msgid "Choose your path and let Abuelita guide you"
msgstr "Elige tu camino y deja que Abuelita te guíe"

#: translator/templates/translator/learn.html:33
msgid "What would you like to learn about?"
msgstr "¿Qué te gustaría aprender?"

#: translator/templates/translator/learn.html:40
msgid "e.g. Common greetings, colors, or simple conversations..."
msgstr "Ej: saludos comunes, colores o conversaciones simples..."

#: translator/templates/translator/learn.html:45
msgid "Learn with Abuelita"
msgstr "Aprender con Abuelita"

#: translator/templates/translator/learn.html:54
msgid "Lesson Result"
msgstr "Resultado de la lección"

#: translator/templates/translator/learn.html:62
msgid "Your lesson will appear here after you start."
msgstr "Tu lección aparecerá aquí después de comenzar."

